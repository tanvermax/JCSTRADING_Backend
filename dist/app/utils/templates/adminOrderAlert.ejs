<!-- templates/adminOrderAlert.ejs -->
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>New Order Alert</title>
</head>
<body style="font-family: Arial, sans-serif; background-color: #f4f5f7; padding: 20px;">
    <div style="max-width: 600px; margin: 0 auto; background-color: #ffffff; padding: 30px; border-radius: 8px; border-top: 4px solid #e11d48; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
        <h2 style="color: #e11d48; margin-top: 0;">🚨 New Order Received!</h2>
        <p>Hi Admin, a new order has been placed on <strong>JCS Trading</strong>. Please review the details below:</p>
        
        <h3 style="color: #334155; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px;">📦 Order Summary</h3>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
            <tr>
                <td style="padding: 6px 0; color: #64748b;"><strong>Order ID:</strong></td>
                <td style="padding: 6px 0; text-align: right; font-family: monospace;"><%= orderId %></td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #64748b;"><strong>Total Bill:</strong></td>
                <td style="padding: 6px 0; text-align: right; font-weight: bold; color: #0f172a;">BDT <%= grandTotal %></td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #64748b;"><strong>Items Count:</strong></td>
                <td style="padding: 6px 0; text-align: right;"><%= itemsCount %> item(s)</td>
            </tr>
        </table>

        <h3 style="color: #334155; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px;">👤 Customer & Shipping Details</h3>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px;">
            <tr>
                <td style="padding: 6px 0; color: #64748b;"><strong>Name:</strong></td>
                <td style="padding: 6px 0; text-align: right;"><%= name %></td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #64748b;"><strong>Phone:</strong></td>
                <td style="padding: 6px 0; text-align: right;"><%= phone %></td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #64748b;"><strong>Email:</strong></td>
                <td style="padding: 6px 0; text-align: right;"><%= customerEmail %></td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #64748b;"><strong>Area:</strong></td>
                <td style="padding: 6px 0; text-align: right; text-transform: capitalize;"><%= shippingArea %> Dhaka</td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #64748b;"><strong>Address:</strong></td>
                <td style="padding: 6px 0; text-align: right;"><%= address %></td>
            </tr>
        </table>

        <div style="text-align: center; margin-top: 30px;">
            <a href="https://jcstradingbd.com/admin/orders" style="background-color: #e11d48; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; display: inline-block;">View on Admin Dashboard</a>
        </div>
    </div>
</body>
</html>